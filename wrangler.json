{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "word-burn",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "WB_KV"
    }
  ],
  "build": {
    "command": "node scripts/build.mjs"
  }
}
